<?xml version="1.0" encoding="utf-8"?>

<!--
  Unit tests for the Doom 3 file parsers (PK4, lexer, decls, images, .proc,
  .map, md5mesh / md5anim), run against the bundled test PK4. Build and run:
    castle-engine compile && ./castle-doom3-tests
  See https://castle-engine.io/project_manifest .
-->
<project name="castle-doom3-tests"
  standalone_source="castle_doom3_tests.dpr"
  qualified_name="io.castleengine.castledoom3.tests"
>
  <compiler_options>
    <search_paths>
      <path value="../code/" />
    </search_paths>
  </compiler_options>
  <data exists="false" />
</project>
